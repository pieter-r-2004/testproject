; Open this file in Godot 4 (standard edition).
config_version=5

[application]
config/name="Autonomous Heroes - Milestone 0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1000
window/size/viewport_height=820
window/size/window_width_override=1000
window/size/window_height_override=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.075, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

[debug]
file_logging/enable_file_logging=false
